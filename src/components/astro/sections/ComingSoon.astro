---
/** biome-ignore-all lint/correctness/noUnusedImports: React icons are used in JSX */
/** biome-ignore-all lint/correctness/noUnusedVariables: variables used in Astro components */

import { FaGooglePlay } from "react-icons/fa";
import { RiTwitterXFill } from "react-icons/ri";
---

<div class="mb-12 pt-4">
	<h2 class="mb-8 text-2xl font-semibold text-gray-900 dark:text-white text-center">
		Android Habit Tracker Coming Soon
	</h2>

	<div class="flex flex-col items-center">
		<!-- Android Card -->
		<div class="flex items-center gap-4 px-8 py-5 rounded-2xl border-2 border-dashed border-gray-300 dark:border-white/10 bg-gray-50/50 dark:bg-white/[0.02] mb-6">
			<div class="flex items-center justify-center w-12 h-12 rounded-xl bg-gray-100 dark:bg-white/[0.04]">
				<FaGooglePlay className="w-6 h-6 text-gray-400 dark:text-gray-500" />
			</div>
			<div>
				<div class="text-lg font-medium text-gray-900 dark:text-white">Android Habit Tracker</div>
				<div class="text-sm text-gray-500 dark:text-gray-400">Coming Soon</div>
			</div>
		</div>

		<!-- Follow Link -->
		<a
			href="https://x.com/habitabilityapp"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
		>
			<RiTwitterXFill className="w-4 h-4" />
			<span>Follow for updates</span>
		</a>
	</div>
</div>
